# Immich + Immich Showcase im selben Stack. Kopieren nach ".env".
# Passwort der Immich-Datenbank (nur Buchstaben und Ziffern; frei waehlen, spaeter nicht mehr aendern ohne Datenbank anzupassen)
DB_PASSWORD=
# Wo die Fotos liegen (Ordner auf dem Server) und wo die Datenbank liegt
UPLOAD_LOCATION=./upload
DB_DATA_LOCATION=./postgres
# Getestete Immich-Version
IMMICH_VERSION=v3.2.4
# Version von Immich Showcase (latest oder z. B. 2.4.0)
SHOWCASE_VERSION=latest
TZ=Europe/Berlin
# Fernseher und Rahmen (kennung=Anzeigename, kommagetrennt); am Geraet die Seite http://<server>:8090/tv/ oeffnen und per Code koppeln
RAHMEN_WEB_TV_ZIELE=wohnzimmer=Wohnzimmer
RAHMEN_WEB_RAHMEN_ZIELE=rahmen=Bilderrahmen
