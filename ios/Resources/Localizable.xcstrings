    },
    "Der Server ist nicht erreichbar. Prüfe die Adresse und ob du im richtigen Netz bist.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server can't be reached. Check the address and whether you are on the right network."
          }
        }
      }
    },
    "Unter dieser Adresse antwortet kein Immich Showcase.": {
      "extractionState": "manual",
