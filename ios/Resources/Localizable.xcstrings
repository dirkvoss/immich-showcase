      }
    },
    "Die PIN wird beim nächsten Anmelden im geschützten Schlüsselbund gemerkt und danach per Face ID eingesetzt.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PIN is remembered in the protected keychain the next time you sign in and then entered with Face ID."
