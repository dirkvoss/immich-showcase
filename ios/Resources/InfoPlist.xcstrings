  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird nur zum Scannen des QR-Codes deines Servers genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is only used to scan the QR code of your server."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID schützt die App, wenn du das in den App-Einstellungen eingeschaltet hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID protects the app if you turned that on in the app settings."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App verbindet sich mit deinem Immich-Showcase-Server im Heimnetz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app connects to your Immich Showcase server on your home network."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Showcase Immich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showcase Immich"
          }
        }
      }
    }
  }
