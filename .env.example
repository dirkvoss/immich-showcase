# =====================================================================================================================
# Immich Showcase – Konfiguration.  Kopieren nach ".env" (cp .env.example .env) und anpassen.
# Keine Anfuehrungszeichen um Werte. Nicht gesetzte Werte haben die hier genannten Vorgaben.
# =====================================================================================================================

# ---------------------------------------------------------------------------------------------------------------------
# 1. Immich  (kann auch leer bleiben: dann fuehrt der Einrichtungsassistent unter http://<server>:8090/setup/ durch die Einrichtung)
# ---------------------------------------------------------------------------------------------------------------------
# Adresse der Immich-API aus Sicht des Immich-Showcase-Containers. Gleiches Docker-Netzwerk: http://immich_server:2283/api
# (dazu COMPOSE_FILE unten aktivieren). Sonst die Adresse des Immich-Rechners: http://192.168.1.10:2283/api
RAHMEN_IMMICH_URL=
# API-Schluessel (Immich: Kontoeinstellungen -> API-Schluessel). Noetige Rechte: asset.read, asset.view, asset.statistics,
# timeline.read, person.read, user.read, album.create, album.read, album.update, album.delete, albumAsset.create, albumAsset.delete, map.read.
# KEINE Loeschrechte fuer Fotos vergeben. Bei RAHMEN_WEB_AUTH=immich dient er nur noch dem Dauerprogramm des Rahmens.
RAHMEN_IMMICH_KEY=

# ---------------------------------------------------------------------------------------------------------------------
# 2. Zugang
# ---------------------------------------------------------------------------------------------------------------------
# Anmeldung: pin (eine gemeinsame 6-stellige PIN) | immich (Immich-Konto: E-Mail + Passwort; jede Person sieht nur ihre Fotos, braucht
# den eingebauten Rahmen-Player statt immich-kiosk) | beide
RAHMEN_WEB_AUTH=pin
# Erste PIN (6 Ziffern). Leer: Immich Showcase wuerfelt beim ersten Start eine aus und schreibt sie EINMAL ins Protokoll (docker compose logs).
# Aendern spaeter: docker compose exec showcase python /app/rahmen_web.py --set-pin 123456
SHOWCASE_PIN=
# Netze, die ohne Anmeldung hinein duerfen (CIDR, kommagetrennt), z. B. 192.168.1.0/24. LEER = jeder braucht PIN/Konto (sicher).
# Im Immich-Betrieb gilt das nur noch fuer Geraete (Fernseher-/Rahmen-Seite).
RAHMEN_WEB_LAN=
# Reverse-Proxys (IP-Adressen), deren X-Real-IP geglaubt wird. Ohne Proxy leer lassen. Achtung: nie die Adresse eines Tunnels/Proxys
# in RAHMEN_WEB_LAN aufnehmen, ueber den Internetverkehr hereinkommt.
RAHMEN_WEB_PROXIES=

# ---------------------------------------------------------------------------------------------------------------------
# 3. Darstellung und Einsatzzweck
# ---------------------------------------------------------------------------------------------------------------------
RAHMEN_WEB_NAME=Immich Showcase
# Wofuer wird die Installation genutzt? rahmen (nur Bilderrahmen) | tv (nur Fernseher) | beides. Blendet unnoetige Knoepfe aus.
RAHMEN_WEB_MODUS=beides
# Beispiele im Suchfeld (Semikolon getrennt), deutsch und englisch
RAHMEN_WEB_BEISPIELE=Sommer 2022; Geburtstag; Strand
RAHMEN_WEB_BEISPIELE_EN=Summer 2022; Birthday; Beach
# Spitznamen fuer Personen in der Suche: "oma=Erika Muster; opa=Karl Muster" (rechts der Name wie in Immich)
RAHMEN_WEB_ALIASE=

# ---------------------------------------------------------------------------------------------------------------------
# 4. Fernseher
# ---------------------------------------------------------------------------------------------------------------------
# Fernseher: Kennung=Anzeigename, kommagetrennt. Am Fernseher im Browser  http://<server>:8090/tv/?ziel=<kennung>  oeffnen.
RAHMEN_WEB_TV_ZIELE=lg=LG TV,shield=Shield
# Adresse der Fernseher-Seite fuer Hinweistexte, z. B. tv.example.com (nur Anzeige)
RAHMEN_WEB_TV_URL=
# Zwischenspeicher fuer fuer den Fernseher umgewandelte Videos in MB
RAHMEN_WEB_VIDEO_CACHE_MB=3000
# Eigene Hintergrundmusik (im Lieferumfang ist KEINE): mp3/ogg/m4a-Dateien in Unterordnern von /data/musik ablegen (jeder Ordner =
# eine Sammlung; Titel/Kuenstler aus den Dateimarken oder dem Dateinamen), z. B. ueber einen Ordner-Mount ./musik:/data/musik:ro.
# Oder direkt in der App hinzufuegen/entfernen: dafuer das Hochladen einschalten (1). Grenzen in MB je Datei / insgesamt.
RAHMEN_WEB_MUSIK_UPLOAD=0
RAHMEN_WEB_MUSIK_MAX_MB=100
RAHMEN_WEB_MUSIK_GESAMT_MB=2000

# ---------------------------------------------------------------------------------------------------------------------
# 5. Bilderrahmen (eingebauter Player)
# ---------------------------------------------------------------------------------------------------------------------
# Rahmen: Kennung=Anzeigename. Am Tablet (Browser oder Fully Kiosk) als Startseite  http://<server>:8090/tv/?ziel=<kennung>
# Im Leerlauf zeigt der Rahmen ein Dauerprogramm mit Uhr; Shows aus der App laufen dort wie auf einem Fernseher.
RAHMEN_WEB_RAHMEN_ZIELE=
# Sekunden pro Foto im Dauerprogramm (3-120)
RAHMEN_WEB_RAHMEN_SEK=8
# Quellen des Dauerprogramms mit Gewicht, kommagetrennt:  <album-id>:70, neu14:20, *:10
#   <album-id> = ein Immich-Album, neuN = in den letzten N Tagen hochgeladen, * = ganze Bibliothek. Leer = ganze Bibliothek.
RAHMEN_WEB_RAHMEN_QUELLEN=
# Alternativ: nur diese Alben (IDs, kommagetrennt) gleichberechtigt; wird ignoriert, wenn RAHMEN_WEB_RAHMEN_QUELLEN gesetzt ist
RAHMEN_WEB_RAHMEN_ALBEN=
# 1 = Alben, deren Beschreibung "#...rahmen..." enthaelt (z. B. "#bilderrahmen"), kommen automatisch zum Dauerprogramm; "#...nurrahmen..." zeigt NUR diese Alben
RAHMEN_WEB_RAHMEN_MARKER=
# Meldung per Pushover, wenn der Rahmen laenger als so viele Minuten nicht erreichbar ist oder dasselbe Bild zeigt (0 = aus)
RAHMEN_WEB_RAHMEN_ALARM_MIN=15

# ---------------------------------------------------------------------------------------------------------------------
# 6. Optional: Benachrichtigung (Pushover, https://pushover.net)
# ---------------------------------------------------------------------------------------------------------------------
RAHMEN_WEB_PUSHOVER_API_KEY=
RAHMEN_WEB_PUSHOVER_USER_KEY=
RAHMEN_WEB_PUSHOVER_DEVICE=

# ---------------------------------------------------------------------------------------------------------------------
# 7. Optional: Immich-Datenbank und Motivsuche
# ---------------------------------------------------------------------------------------------------------------------
# Lesezugriff auf Immichs Postgres (eigene Nur-Lese-Rolle anlegen!). Ohne: alles laeuft ueber die Immich-API (Filter etwas langsamer;
# die Motivsuche "am Strand" nimmt dann die ersten RAHMEN_MOTIV_OHNE_DB Treffer statt die Aehnlichkeit exakt zu pruefen).
# Beispiel: postgresql://rahmen_ro:PASSWORT@immich_postgres:5432/immich
RAHMEN_DB_DSN=
# Datenbank trotz gesetzter DSN nicht fuer Filter nutzen (zum Testen): api
RAHMEN_FACETTEN=
RAHMEN_MOTIV_OHNE_DB=60
# Adresse des Immich-Machine-Learning (nur mit RAHMEN_DB_DSN fuer die exakte Motivpruefung), z. B. http://immich_machine_learning:3003/predict
RAHMEN_ML_URL=

# ---------------------------------------------------------------------------------------------------------------------
# 8. Betrieb (Docker Compose)
# ---------------------------------------------------------------------------------------------------------------------
# Version des Images (Tag aus dem Repository, z. B. 1.2.0). Fuer Updates mit deploy/deploy.sh wird sie dort automatisch gesetzt.
SHOWCASE_VERSION=latest
# Port und Bindung auf dem Server. 127.0.0.1 = nur lokal (z. B. hinter einem Reverse-Proxy auf demselben Rechner)
SHOWCASE_PORT=8090
SHOWCASE_BIND=0.0.0.0
SHOWCASE_CONTAINER=showcase
SHOWCASE_MEMORY=768m
TZ=Europe/Berlin
# Datenverzeichnis: Volume-Name (Vorgabe) oder Ordner (z. B. ./data; dann SHOWCASE_UID/SHOWCASE_GID auf dessen Besitzer setzen: id -u / id -g)
SHOWCASE_DATA=showcase_data
SHOWCASE_UID=10001
SHOWCASE_GID=10001
# Zusatzdateien: Immich in anderem Docker-Netzwerk (docker-compose.immich-network.yml) und/oder selbst bauen (docker-compose.build.yml)
# COMPOSE_FILE=docker-compose.yml:docker-compose.immich-network.yml
# SHOWCASE_IMMICH_NETWORK=immich_default
